# Ambiente de evolucao/homologacao do SXData (sxdata.online)
DOMINIO_PAINEL=painel.sxdata.online
DOMINIO_APP=app.sxdata.online
# Dominios que so redirecionam para o painel (vazio = nenhum)
DOMINIOS_REDIRECIONA="sxdata.online www.sxdata.online"
# Nome do certificado em /etc/letsencrypt/live (cobre todos os dominios acima)
CERTIFICADO=painel.sxdata.online
# config.php do CodeIgniter para este ambiente (relativo a pasta deploy/)
CONFIG_PHP=evolucao/config.php
# Processos PHP simultaneos deste ambiente
PHP_MAX_CHILDREN=12
